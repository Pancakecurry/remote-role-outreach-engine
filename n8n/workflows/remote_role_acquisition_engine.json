    { "parameters": { "content": "## OUTREACH STATE — SUPABASE\nThe daily acquisition spine persists operational state here. Delivery, inbox, follow-up, and operations branches independently re-enter guarded application APIs; n8n never owns lifecycle truth.", "height": 170, "width": 3100, "color": 7 }, "id": "note-state-spine", "name": "Outreach State — Supabase", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [1050, 1510] },
