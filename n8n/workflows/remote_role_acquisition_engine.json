  "nodes": [
    { "parameters": { "content": "# REMOTE ROLE ACQUISITION ENGINE\n## Canonical n8n canvas\nOne compact daily spine with independent, guarded operational branches. Application rules and Supabase state remain authoritative.", "height": 180, "width": 3380, "color": 7 }, "id": "note-title", "name": "System Architecture", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [220, 20] },
    { "parameters": { "content": "## AUTOMATED ACQUISITION\nEvery four hours, Asia/Kolkata. Ingest -> qualify -> rank -> application package -> public contacts -> truthful drafts.\nThe manual Apply Now queue stays useful even when no safe contact exists. Gmail is never called from this branch.", "height": 1000, "width": 3380, "color": 5 }, "id": "note-daily", "name": "A — Automated Acquisition", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [220, 240] },
    { "parameters": { "content": "## FAILURE HANDLING\nA failed request stops only dependent work. Earlier Supabase state remains intact and visible in operations.", "height": 130, "width": 3380, "color": 1 }, "id": "note-errors", "name": "L — Error & Failure Handling", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [220, 1090] },

    { "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 */4 * * *" }] } }, "id": "daily-trigger", "name": "Discover Jobs Every Four Hours", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [340, 570] },
