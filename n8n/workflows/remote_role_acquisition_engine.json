    { "parameters": { "method": "POST", "url": "={{ $env.INTERNAL_API_BASE_URL }}/api/internal/pipeline/contacts", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": { "timeout": 300000 } }, "id": "daily-contacts", "name": "Discover Public Company Contacts", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [3460, 520], "onError": "continueErrorOutput" },
