    { "parameters": { "assignments": { "assignments": [{ "id": "stage", "name": "failureStage", "value": "draft generation", "type": "string" }] }, "options": {} }, "id": "failure-drafts", "name": "Record Draft Generation Failure", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [4460, 1170] },
