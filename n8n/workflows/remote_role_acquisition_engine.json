    { "parameters": { "method": "GET", "url": "={{ $env.INTERNAL_API_BASE_URL }}/api/internal/operations/status", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": { "timeout": 30000 } }, "id": "daily-complete", "name": "Record Daily Pipeline Completion", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [4760, 520], "onError": "continueErrorOutput" },
