    { "parameters": { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "leftValue": "={{ $json.locked }}", "rightValue": true, "operator": { "type": "boolean", "operation": "false" } }] } }, "id": "ingestion-ok", "name": "Check Ingestion Result", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1220, 570] },
    { "parameters": { "method": "POST", "url": "={{ $env.INTERNAL_API_BASE_URL }}/api/internal/pipeline/qualify", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "contentType": "json", "jsonBody": "{\"mode\":\"incremental\",\"limit\":25}", "options": { "timeout": 300000 } }, "id": "daily-qualify", "name": "Run Incremental Gemini Qualification", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1490, 570], "onError": "continueErrorOutput", "notes": "The application assesses only new, changed, or due retryable jobs and updates ranking." },
    { "parameters": { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "leftValue": "={{ $json.failed }}", "rightValue": 0, "operator": { "type": "number", "operation": "largerEqual" } }] } }, "id": "qualification-ok", "name": "Check Qualification Result", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1820, 570] },
