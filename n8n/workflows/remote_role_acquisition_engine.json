    { "parameters": { "assignments": { "assignments": [{ "id": "stage", "name": "failureStage", "value": "ingestion", "type": "string" }] }, "options": {} }, "id": "failure-ingestion", "name": "Record Ingestion Failure", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [1300, 1170] },
    { "parameters": { "assignments": { "assignments": [{ "id": "stage", "name": "failureStage", "value": "qualification", "type": "string" }] }, "options": {} }, "id": "failure-qualification", "name": "Record Qualification Failure", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [2070, 1170] },
