    { "parameters": { "method": "POST", "url": "={{ $env.INTERNAL_API_BASE_URL }}/api/internal/pipeline/packages", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": { "timeout": 300000 } }, "id": "daily-packages", "name": "Generate Tailored Application Packages", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2260, 570], "onError": "continueErrorOutput", "notes": "Creates or reuses an idempotent one-page resume package and falls back to the selected original PDF on rendering failure." },
    { "parameters": { "method": "POST", "url": "={{ $env.INTERNAL_API_BASE_URL }}/api/internal/pipeline/contacts", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "options": { "timeout": 300000 } }, "id": "daily-contacts", "name": "Discover Public Company Contacts", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2410, 570], "onError": "continueErrorOutput" },
