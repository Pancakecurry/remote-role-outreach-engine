  "nodes": [
    { "parameters": { "content": "# REMOTE ROLE ACQUISITION ENGINE\n## Canonical orchestration canvas\nApplication rules + Supabase state remain authoritative. All delivery paths are guarded by the application claim API.", "height": 260, "width": 1160, "color": 7 }, "id": "note-title", "name": "System Architecture", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [180, 20] },
    { "parameters": { "content": "## A — DAILY ACQUISITION\n17:00 Asia/Kolkata · Ingest → qualify/rank → contact research → drafts\nNever sends Gmail.", "height": 650, "width": 4900, "color": 5 }, "id": "note-daily", "name": "A — Daily Acquisition", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [180, 300] },
    { "parameters": { "content": "## B — JOB INGESTION\nApplication owns public ATS retrieval, source health, lifecycle, dedupe, and the ingestion lock.", "height": 240, "width": 630, "color": 4 }, "id": "note-ingestion", "name": "B — Job Ingestion", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [1030, 620] },
    { "parameters": { "content": "## C — QUALIFICATION\nIncremental Gemini assessment only. Hard rejects remain absolute; bounded backfill remains app-owned.", "height": 240, "width": 650, "color": 4 }, "id": "note-qualification", "name": "C — Qualification", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [1820, 620] },
    { "parameters": { "content": "## D — RANKING & APPLICATION QUEUE\nApplication updates the manual queue after qualification. Contact availability never controls application selection.", "height": 240, "width": 650, "color": 4 }, "id": "note-ranking", "name": "D — Ranking & Application Queue", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [2600, 620] },
    { "parameters": { "content": "## E — CONTACT DISCOVERY\nOfficial sites only · bounded crawl · SSRF/DNS/domain/MX/evidence gates. No safe contact never rejects a job.", "height": 240, "width": 650, "color": 4 }, "id": "note-contacts", "name": "E — Contact Discovery", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [3390, 620] },
    { "parameters": { "content": "## F — OUTREACH DRAFTING\nGemini drafts only after selected public evidence. Truthful-claim validation remains inside the application.", "height": 240, "width": 650, "color": 4 }, "id": "note-drafts", "name": "F — Outreach Drafting", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [4180, 620] },
    { "parameters": { "content": "## L — FAILURE HANDLING\nEach failed request stops only its dependent stage. Earlier Supabase state is preserved and operations status remains available.", "height": 260, "width": 980, "color": 1 }, "id": "note-errors", "name": "L — Error & Failure Handling", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [2600, 1040] },

