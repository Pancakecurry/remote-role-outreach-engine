{
  "name": "remote-role-outreach-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contact-extraction": "vitest run tests/contact-extraction.test.ts",
    "preflight": "tsx scripts/preflight-env.ts && tsx scripts/preflight-gemini.ts && tsx scripts/preflight-supabase.ts && tsx scripts/preflight-dns.ts",
    "preflight:env": "tsx scripts/preflight-env.ts",
    "preflight:gemini": "tsx scripts/preflight-gemini.ts",
    "preflight:supabase": "tsx scripts/preflight-supabase.ts",
    "verify:supabase": "tsx scripts/verify-supabase.ts",
    "preflight:dns": "tsx scripts/preflight-dns.ts",
    "verify:owner": "node --conditions=react-server --import tsx scripts/verify-owner.ts",
    "verify:demo": "node --conditions=react-server --import tsx scripts/verify-demo-data.ts",
    "seed:demo": "node --conditions=react-server --import tsx scripts/seed-demo-data.ts",
    "seed:remove": "node --conditions=react-server --import tsx scripts/remove-demo-data.ts",
    "test:smoke": "node --import tsx scripts/smoke-test.ts",
    "sources:seed": "node --conditions=react-server --import tsx scripts/seed-job-sources.ts",
    "sources:verify": "node --conditions=react-server --import tsx scripts/verify-job-sources.ts",
    "ingest:jobs": "node --conditions=react-server --import tsx scripts/run-job-ingestion.ts",
    "ingest:jobs:controlled": "node --conditions=react-server --import tsx scripts/run-job-ingestion.ts --one-per-provider",
    "ingest:jobs:dry-run": "node --conditions=react-server --import tsx scripts/run-job-ingestion.ts --dry-run",
    "ingest:unlock": "node --conditions=react-server --import tsx scripts/recover-ingestion-lock.ts",
    "verify:ingestion": "node --conditions=react-server --import tsx scripts/verify-job-ingestion.ts",
    "pipeline:run": "node --conditions=react-server --import tsx scripts/run-release-pipeline.ts",
    "pipeline:master": "node --conditions=react-server --import tsx scripts/run-daily-acquisition.ts",
    "pipeline:rerank": "node --conditions=react-server --import tsx scripts/rerank-application-queue.ts",
    "pipeline:qualify": "node --conditions=react-server --import tsx scripts/run-qualification.ts",
    "pipeline:qualify:dry-run": "node --conditions=react-server --import tsx scripts/run-qualification.ts --dry-run",
    "pipeline:backfill": "node --conditions=react-server --import tsx scripts/run-qualification.ts --backfill",
    "pipeline:status": "node --conditions=react-server --import tsx scripts/pipeline-status.ts",
    "pipeline:contacts": "node --conditions=react-server --import tsx scripts/run-contact-discovery.ts",
    "stack:start": "docker compose up -d --build",
    "stack:stop": "docker compose down",
    "stack:restart": "docker compose down && docker compose up -d --build",
    "stack:status": "docker compose ps",
    "stack:logs": "docker compose logs --tail=100",
    "stack:verify": "tsx scripts/verify-stack.ts",
    "verify:stack": "tsx scripts/verify-stack.ts",
    "verify:n8n-workflows": "tsx scripts/verify-n8n-workflows.ts",
    "verify:qualification": "node --conditions=react-server --import tsx scripts/verify-qualification.ts",
    "verify:contacts": "node --conditions=react-server --import tsx scripts/verify-contacts.ts",
    "verify:outreach": "node --conditions=react-server --import tsx scripts/verify-outreach.ts",
    "verify:self-test": "node --conditions=react-server --import tsx scripts/verify-self-test.ts",
    "verify:production-readiness": "tsx scripts/verify-production-readiness.ts",
    "verify:end-to-end": "node --conditions=react-server --import tsx scripts/verify-end-to-end.ts",
    "verify:release-candidate": "node --conditions=react-server --import tsx scripts/verify-release-candidate.ts",
    "diagnose:qualification": "node --conditions=react-server --import tsx scripts/diagnose-qualification.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.57.4",
    "cheerio": "^1.1.2",
    "next": "^16.2.12",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
